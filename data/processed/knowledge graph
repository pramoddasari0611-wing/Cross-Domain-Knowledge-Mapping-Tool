import pandas as pd
import networkx as nx
import matplotlib.pyplot as plt
import os

# Load your dataset

file_path = "/Users/dasari/Downloads/Cross_ Domain_Knowledge/ner.csv"
if not os.path.exists(file_path):
    raise FileNotFoundError(f"❌ File not found at: {file_path}")

df = pd.read_csv(file_path)
print("✅ File loaded successfully!")
print("Columns in dataset:", list(df.columns))
print(df.head(), "\n")

# Prepare triples from your data

# We use Sentence → has_tag → Tag
if "Sentence" in df.columns and "Tag" in df.columns:
    df["subject"] = df["Sentence"]
    df["relation"] = "has_tag"
    df["object"] = df["Tag"]
else:
    raise ValueError("❌ 'Sentence' and 'Tag' columns not found in dataset!")

#  Build directed graph

G = nx.DiGraph()

for _, row in df.iterrows():
    subj = str(row["subject"]).strip()
    obj = str(row["object"]).strip()
    rel = str(row["relation"]).strip()
    if subj and obj and subj.lower() != "nan" and obj.lower() != "nan":
        G.add_edge(subj, obj, label=rel)

print(f"\n✅ Graph built with {G.number_of_nodes()} nodes and {G.number_of_edges()} edges.\n")

# -------------------------------------
# 4️⃣ Display example relations
# -------------------------------------
print("📘 Sample Relations Extracted:\n")
for node in list(G.nodes())[:5]:
    outgoing = list(G.out_edges(node, data=True))
    if outgoing:
        print(f"Entity: {node}")
        for _, obj, data in outgoing:
            print(f" → {obj} | Relation: {data['label']}")
        print("-" * 40)

# -------------------------------------
# 5️⃣ Visualize the graph
# -------------------------------------
if G.number_of_nodes() > 0:
    plt.figure(figsize=(12, 8))
    pos = nx.spring_layout(G, k=0.5, iterations=50)
    edge_labels = nx.get_edge_attributes(G, 'label')

    nx.draw(
        G, pos, with_labels=True,
        node_size=2000, node_color="lightblue",
        arrows=True, font_size=8, font_weight='bold'
    )
    nx.draw_networkx_edge_labels(G, pos, edge_labels=edge_labels, font_color='red')

    plt.title("Knowledge Graph from ner.csv", fontsize=14)
    plt.tight_layout()
    plt.show()
else:
    print("⚠️ No valid nodes or edges found — check your dataset content.")

# -------------------------------------
# 6️⃣ Save the graph
# -------------------------------------
output_graphml = os.path.join(os.path.dirname(file_path), "knowledge_graph.graphml")
nx.write_graphml(G, output_graphml)
print(f"\n📁 Graph saved to: {output_graphml}")
